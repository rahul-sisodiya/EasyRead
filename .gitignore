# =========================================================
# ENVIRONMENT VARIABLES / SECRETS
# =========================================================

.env
.env.*
!.env.example

# Spring Boot local configuration containing secrets
application-local.properties
application-local.yml

# Any local secret/config files
secrets/
*.secret
*.key
*.pem


# =========================================================
