backend/target/
**/target/

*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

hs_err_pid*
replay_pid*

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven Wrapper (if not using wrapper, these can be kept ignored)
.mvn/wrapper/maven-wrapper.properties
.mvnw
.mvnw.cmd

# Spring Boot logs
logs/
*.log


